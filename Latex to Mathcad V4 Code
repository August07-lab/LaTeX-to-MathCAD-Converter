                                         "DejaVu Sans") if f in fams), "TkDefaultFont")
        self.mono_font = next((f for f in ("Cascadia Mono", "Consolas", "DejaVu Sans Mono",
                                           "Courier New") if f in fams), "TkFixedFont")

