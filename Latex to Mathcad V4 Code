    def _build_calibration(self, tab):
        ttk, tk = self.ttk, self.tk
        tab.columnconfigure(0, weight=1)
        self.mk(ttk.Label, tab, "h_calibrate", style="Heading.TLabel").grid(row=0, column=0,
                                                                              sticky="w")
        lbl = self.mk(ttk.Label, tab, "txt_cal_intro", style="Muted.TLabel", justify="left")
        lbl.grid(row=1, column=0, sticky="w", pady=(4, 10))
        self.wrapping(lbl, tab, 40)
        grid = ttk.Frame(tab)
        grid.grid(row=2, column=0, sticky="ew")
        grid.columnconfigure(1, weight=1)
        self.cal_vars, self.cal_boxes, self.cal_extra = {}, {}, {}

        def candidates(key):
            return list(SX_CHOICES[key][1]) + self.cal_extra.get(key, [])

        def copy_sample(key):
            sample = sx_sample(key)
            self.to_clipboard(sample)
            self.say("s_sample_copied", sample=sample)

        def next_candidate(key):
            cands = candidates(key)
            cur = self.cal_vars[key].get()
            idx = cands.index(cur) if cur in cands else -1
            nxt = cands[(idx + 1) % len(cands)]
            self.cal_vars[key].set(nxt)
            SX_TPL[key] = nxt
            sample = sx_sample(key)
            self.to_clipboard(sample)
            self.say("s_candidate_copied", n=(idx + 1) % len(cands) + 1, total=len(cands),
                     sample=sample)

        for r, (key, (label_key, cands)) in enumerate(SX_CHOICES.items()):
            self.mk(ttk.Label, grid, label_key).grid(row=r, column=0, sticky="w", pady=3,
                                                     padx=(0, 10))
            var = tk.StringVar(value=SX_TPL[key])
            var.trace_add("write", lambda *_a, k=key, v=var: SX_TPL.__setitem__(k, v.get()))
            cb = ttk.Combobox(grid, textvariable=var, values=cands)
            cb.grid(row=r, column=1, sticky="ew", pady=3)
            self.cal_vars[key], self.cal_boxes[key] = var, cb
            self.mk(ttk.Button, grid, "btn_copy_sample", style="Small.TButton",
                    command=lambda k=key: copy_sample(k)).grid(row=r, column=2, padx=(8, 0))
            self.mk(ttk.Button, grid, "btn_next_candidate", style="Small.TButton",
                    command=lambda k=key: next_candidate(k)).grid(row=r, column=3, padx=(6, 0))

        ttk.Separator(tab).grid(row=3, column=0, sticky="ew", pady=12)
        self.mk(ttk.Label, tab, "h_learn", style="Heading.TLabel").grid(row=4, column=0,
                                                                         sticky="w")
        lbl2 = self.mk(ttk.Label, tab, "txt_learn_intro", style="Muted.TLabel",
                       justify="left")
        lbl2.grid(row=5, column=0, sticky="w", pady=(4, 8))
        self.wrapping(lbl2, tab, 40)
        row = ttk.Frame(tab)
        row.grid(row=6, column=0, sticky="ew")
        row.columnconfigure(1, weight=1)
        self.cb_learn = ttk.Combobox(row, state="readonly", width=30)
        self.cb_learn.grid(row=0, column=0, sticky="w")
        self.hint_var = tk.StringVar()
        ttk.Label(row, textvariable=self.hint_var, style="Muted.TLabel").grid(
            row=0, column=1, sticky="w", padx=10)
        self.cb_learn.bind("<<ComboboxSelected>>", lambda _e: self.refresh_learn_hint())
        box, self.learn_box = self.make_text(tab, role="normal", height=4)
        box.grid(row=7, column=0, sticky="ew", pady=(8, 0))
        row2 = ttk.Frame(tab)
        row2.grid(row=8, column=0, sticky="ew", pady=(8, 0))
        self.mk(ttk.Button, row2, "btn_learn", command=self.do_learn).pack(side="left")
        self.learn_msg = tk.StringVar()
        ttk.Label(row2, textvariable=self.learn_msg, style="Accent.TLabel").pack(
            side="left", padx=12)
        self.cal_candidates = candidates
        self.refresh_learn_hint(first=True)

    def _learn_key(self):
        sel = self.cb_learn.current() if hasattr(self.cb_learn, "current") else -1
        keys = list(SX_CHOICES)
        return keys[sel] if isinstance(sel, int) and 0 <= sel < len(keys) else keys[0]

    def refresh_learn_hint(self, first=False):
        if not hasattr(self, "cb_learn"):
            return
        keys = list(SX_CHOICES)
        idx = 0
        if not first:
            cur = self.cb_learn.current()
            idx = cur if isinstance(cur, int) and 0 <= cur < len(keys) else 0
        else:
            idx = keys.index("sqrt")
        self.cb_learn.configure(values=[f"{k} - {tr(SX_CHOICES[k][0])}" for k in keys])
        self.cb_learn.current(idx)
        self.hint_var.set(tr("lbl_type_in_prime", example=tr(SX_LEARN[keys[idx]][0])))

    def do_learn(self):
        key = self._learn_key()
        try:
            tpl = learn_template(key, self.learn_box.get("1.0", "end"))
        except ValueError as exc:
            self.learn_msg.set("✖ " + str(exc))
            return
        self.cal_extra.setdefault(key, []).append(tpl)
        self.cal_boxes[key]["values"] = self.cal_candidates(key)
        self.cal_vars[key].set(tpl)
        SX_TPL[key] = tpl
        self.learn_msg.set(tr("s_learned", item=key, tpl=tpl))
        self.say("s_template_updated", item=key)

