    # ------------------------------------------------------------------ util
    def _make_vars(self):
        tk, c = self.tk, self.cfg
        self.v_lang = tk.StringVar(value=c["language"])
        self.v_theme = tk.StringVar(value=c["theme"])
        self.v_top = tk.BooleanVar(value=c["topmost"])
        self.v_sub = tk.StringVar(value=c["subscript"])
        self.v_define = tk.BooleanVar(value=c["define"])
        self.v_mul = tk.BooleanVar(value=c["implicit_mult"])
        self.v_rules = tk.BooleanVar(value=c["apply_rules"])
        self.v_watch = tk.BooleanVar(value=False)
        self.v_count = tk.IntVar(value=c["countdown"])
        self.v_delay = tk.IntVar(value=c["delay"])
        self.v_greek = tk.BooleanVar(value=c["greek"])
        self.v_real = tk.BooleanVar(value=c["real_keys"])
        self.nav_text = tk.StringVar(value="0/0")
        self.status = tk.StringVar(value="")
        for name in ("v_top", "v_sub", "v_define", "v_mul", "v_rules", "v_count",
                     "v_delay", "v_greek", "v_real"):
            getattr(self, name).trace_add("write", lambda *_a: self.persist())

    def persist(self):
        if self._loading:
            return
        c = self.cfg
        c["language"], c["theme"] = self.v_lang.get(), self.v_theme.get()
        c["topmost"], c["subscript"] = bool(self.v_top.get()), self.v_sub.get()
        c["define"], c["implicit_mult"] = bool(self.v_define.get()), bool(self.v_mul.get())
        c["apply_rules"] = bool(self.v_rules.get())
        c["countdown"], c["delay"] = self._int(self.v_count, 4), self._int(self.v_delay, 50)
        c["greek"], c["real_keys"] = bool(self.v_greek.get()), bool(self.v_real.get())
        save_settings(c)

    @staticmethod
    def _int(var, default):
        try:
            return int(var.get())
        except Exception:                                  # noqa: BLE001
            return default

    def mk(self, cls, parent, key=None, tip=None, **kw):
        """Buat widget; 'key' = kunci teks (ikut bahasa), 'tip' = kunci tooltip."""
        w = cls(parent, **kw)
        if key:
            w.configure(text=tr(key))
            self._reg.append((w, "text", key))
        if tip:
            self._tips.append(Tooltip(self.tk, w, lambda k=tip: tr(k)))
        return w

    def make_text(self, parent, role="normal", height=4, font=None, **kw):
        """Text + scrollbar dalam satu frame. -> (frame, text)"""
        ttk, tk = self.ttk, self.tk
        fr = ttk.Frame(parent)
        fr.columnconfigure(0, weight=1)
        fr.rowconfigure(0, weight=1)
        txt = tk.Text(fr, height=height, wrap=kw.pop("wrap", "word"),
                      font=font or (self.mono_font, 11), undo=True, maxundo=-1,
                      autoseparators=True, borderwidth=0, **kw)
        sb = ttk.Scrollbar(fr, orient="vertical", command=txt.yview)
        txt.configure(yscrollcommand=sb.set)
        txt.grid(row=0, column=0, sticky="nsew")
        sb.grid(row=0, column=1, sticky="ns")
        self._texts.append((txt, role))
        txt.bind("<Control-a>", lambda e: (e.widget.tag_add("sel", "1.0", "end-1c"), "break")[1])
        return fr, txt

    def wrapping(self, label, container, pad=24):
        container.bind("<Configure>",
                       lambda e, lb=label: lb.configure(wraplength=max(200, e.width - pad)),
                       add="+")

    def say(self, key, **kw):
        self._status = (key, kw)
        self.status.set(tr(key, **kw))

    # ---------------------------------------------------------------- bahasa
    def retext(self):
        for w, opt, key in self._reg:
            w.configure(**{opt: tr(key)})
        for i, (_fr, key) in enumerate(self._tabs):
            self.nb.tab(i, text=tr(key))
        self.status.set(tr(self._status[0], **self._status[1]))
        self.refresh_notes()
        self.render_help()
        self.refresh_learn_hint()
        self.update_nav()
        self.root.title(APP_TITLE)

    def set_lang(self, code, from_header=False):
        if code not in LANGS:
            return
        set_language(code)
        if self.v_lang.get() != code:
            self.v_lang.set(code)
        self.cb_lang.set(LANGS[code])
        self.cfg["language"] = code
        self.persist()
        self.retext()

